# Raw Audio 实验版：PCM -> VAD/KWS -> 本地 ASR -> OpenAI-compatible LLM

# 默认模型来源：deepseek / openai / gemini / ollama / openclaw / custom
# 运行中也可以语音切换：切换deepseek / 切换openai / 切换谷歌 / 切换ollama / 切换open
# 如果 ASR 把“切换openai”听成 “I open AI/open AI/欧盆AI”，也会按 OpenAI 处理。
RAWAUDIO_DEFAULT_PROVIDER=deepseek

# 默认每次请求会动态注入当前日期时间，避免模型把今天说成训练数据里的旧日期。
RAWAUDIO_TIMEZONE=Asia/Shanghai
RAWAUDIO_INJECT_DATE=true

# 默认会按当前 provider/model 自动生成身份提示；问“当前模型/什么大模型”会直接按配置播报。
# 需要完全自定义时再取消下一行注释。
# XIAOAI_SYSTEM_PROMPT=你是运行在音箱上的AI语音助手，不要自称小爱。回答要口语化、简短，不要 markdown。

# 每次真正请求大模型前，在日志里显示实际路由到哪个模型和域名，不显示 API Key。
RAWAUDIO_LOG_ROUTE=true

# 口播输出规则会放进 system prompt，不会拼到“我说”的用户文本后面。
RAWAUDIO_RULE_PROMPT=将回复处理成纯文字口播版，不要返回 markdown，不要包含代码块，不要复述这些规则，300字以内。

# 自定义唤醒词，多个用英文逗号分隔。改完后重建容器以重新生成关键词文件。
RAWAUDIO_WAKE_KEYWORDS=你好小黑,小黑小黑
RAWAUDIO_WAKE_PROMPT=我在
RAWAUDIO_EXIT_PROMPT=再见
RAWAUDIO_EXIT_KEYWORDS=退出,停止,再见

# 默认像原生小爱一样问一句答一句，回答完就结束本轮监听。
# 想恢复旧版连续追问模式时改为 false。
RAWAUDIO_SINGLE_TURN=true
RAWAUDIO_AFTER_TURN_PROMPT=

# 实时打断属于实验功能，默认关闭，避免音箱把自己的回复收进麦克风后反复自问自答。
# 确认音箱没有回声误触发后，可手动改为 true；宽限期越长，误触发越少。
RAWAUDIO_BARGE_IN=false
RAWAUDIO_BARGE_IN_GRACE_MS=1200

# 本地 ASR 偶发把唤醒词识别成这些短句时直接忽略，不送进大模型。
RAWAUDIO_IGNORE_ASR_TEXTS=你好小气,你好神气,你好想气,你好小七,你好小青,你好小新

# VAD/KWS 参数。误触发多就调高 threshold；不灵敏就调低。
RAWAUDIO_KWS_THRESHOLD=0.2
RAWAUDIO_KWS_SCORE=2.0
RAWAUDIO_VAD_THRESHOLD=0.10
RAWAUDIO_INPUT_GAIN=1.0

# ASR 模型：sense_voice / paraformer / fire_red_asr / doubao
RAWAUDIO_ASR_MODEL=sense_voice
RAWAUDIO_ASR_INT8=true

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI 或兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gemini OpenAI-compatible API
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash

# Ollama
OLLAMA_BASE_URL=http://192.168.2.193:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:4b

# OpenClaw API Bridge
OPENCLAW_BASE_URL=http://192.168.2.238:11435/v1
OPENCLAW_API_KEY=xiaoai-local
OPENCLAW_DISPLAY_MODEL=open

# Custom OpenAI Compatible API
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# LLM / 上下文
CONVERSATION_TURNS=6
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7

# TTS：默认 xiaoai 使用小爱原生 TTS；填豆包 speaker id 则使用豆包 TTS。
RAWAUDIO_TTS_SPEAKER=xiaoai
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_KEY=
DOUBAO_TTS_SPEAKER=zh_female_vv_uranus_bigtts
DOUBAO_TTS_FORMAT=pcm
DOUBAO_TTS_STREAM=true

# Docker
# 网络模式：bridge 使用端口映射 4499:4399；host 可绕过 OpenWrt Docker bridge DNS/NAT 问题，
# 但 WebSocket 会直接占用宿主机 4399，不能和普通刷机版服务同时占用同一端口。
XIAOAI_DOCKER_NETWORK_MODE=bridge

# OpenWrt Docker 容器解析 api.deepseek.com 失败时使用；留空时安装脚本会在 OpenWrt 上自动使用下面两个 DNS。
# host 网络模式通常不需要这个配置。
XIAOAI_DOCKER_DNS=223.5.5.5,119.29.29.29
