# 小米账号。MI_USER 必须填写小米 ID，不是手机号或邮箱。
MI_USER=
MI_PASS=
# 米家中设置的音箱名称或设备 DID。
MI_DID=
# 音箱型号代码，例如 LX06、L05B、OH2P。
XIAOAI_HARDWARE=LX06

# 任意 OpenAI 兼容接口。接入 OpenClaw bridge 时模型名填 open。
OPENAI_BASE_URL=http://192.168.2.238:11435/v1
OPENAI_API_KEY=xiaoai-local
OPENAI_MODEL=open

# 说“问AI……”触发单次回答；说“打开AI”进入连续对话。
XIAOAI_CALL_KEYWORD=问AI
XIAOAI_WAKE_KEYWORD=打开AI
XIAOAI_EXIT_KEYWORD=关闭AI
# 部分机型不支持连续对话，失败时改成 false。
XIAOAI_STREAM_RESPONSE=false
XIAOAI_DEBUG=false
