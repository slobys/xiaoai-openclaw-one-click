# =========================
# 1. 小米账号和音箱
# =========================
# MI_USER 必须填写小米 ID，不是手机号或邮箱。
MI_USER=
MI_PASS=
# 从浏览器登录小米账号后提取的 passToken Cookie，可留空。
# 填写后脚本会生成 MiGPT 登录缓存，优先用 Cookie 登录，减少异地验证。
MI_PASS_TOKEN=
# 米家中设置的音箱名称或设备 DID。
MI_DID=
# 音箱型号代码，例如 LX06、L05B、OH2P。
XIAOAI_HARDWARE=LX06

# =========================
# 2. 语音触发
# =========================
# 说“问AI……”触发单次回答；说“打开AI / 开启AI / 开启小爱”进入连续对话。
XIAOAI_CALL_KEYWORD=问AI
XIAOAI_WAKE_KEYWORD=打开AI
XIAOAI_EXIT_KEYWORD=关闭AI
# 部分机型不支持连续对话，异常时改成 false。
XIAOAI_STREAM_RESPONSE=true
XIAOAI_DEBUG=false

# =========================
# 3. 默认模型和上下文
# =========================
# 可选：openclaw / openai / deepseek / gemini / ollama。
XIAOAI_DEFAULT_PROVIDER=openclaw
CONVERSATION_TURNS=6
LLM_TIMEOUT_MS=30000

# =========================
# 4. OpenClaw API Bridge
# =========================
# 菜单 4 部署后，填 http://OpenClaw设备IP:11435/v1。
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=xiaoai-local
OPENCLAW_DISPLAY_MODEL=open
OPENCLAW_TIMEOUT_MS=90000
OPENCLAW_TEST_TIMEOUT_MS=30000

# =========================
# 5. OpenAI
# =========================
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =========================
# 6. DeepSeek
# =========================
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# =========================
# 7. Gemini
# =========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# =========================
# 8. Ollama
# =========================
OLLAMA_BASE_URL=
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=90000
