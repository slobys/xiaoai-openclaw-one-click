# 小米账号。MI_USER 必须填写小米 ID，不是手机号或邮箱。
MI_USER=
MI_PASS=
# 可选：从浏览器登录小米账号后提取的 passToken Cookie。
# 填写后脚本会生成 MiGPT 登录缓存，优先用 Cookie 登录，减少异地验证。
MI_PASS_TOKEN=
# 米家中设置的音箱名称或设备 DID。
MI_DID=
# 音箱型号代码，例如 LX06、L05B、OH2P。
XIAOAI_HARDWARE=LX06

# 默认模型来源：openclaw / ollama / deepseek / openai / gemini。
XIAOAI_DEFAULT_PROVIDER=openclaw
CONVERSATION_TURNS=6
LLM_TIMEOUT_MS=30000

# OpenClaw API Bridge。菜单 4 部署后，填 http://OpenClaw设备IP:11435/v1。
OPENCLAW_BASE_URL=http://192.168.2.238:11435/v1
OPENCLAW_API_KEY=xiaoai-local
OPENCLAW_DISPLAY_MODEL=open
OPENCLAW_TIMEOUT_MS=90000
OPENCLAW_TEST_TIMEOUT_MS=30000

# Ollama OpenAI-compatible 接口。
OLLAMA_BASE_URL=
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=90000

# DeepSeek。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI 或其他 OpenAI-compatible 云接口。
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 说“问AI……”触发单次回答；说“打开AI / 开启AI / 开启小爱”进入连续对话。
XIAOAI_CALL_KEYWORD=问AI
XIAOAI_WAKE_KEYWORD=打开AI
XIAOAI_EXIT_KEYWORD=关闭AI
# 部分机型不支持连续对话，异常时改成 false。
XIAOAI_STREAM_RESPONSE=true
XIAOAI_DEBUG=false
